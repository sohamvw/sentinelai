# =====================================================
# SentinelAI - Root .gitignore
# =====================================================

# ---------------------
# Python
# ---------------------
backend/.venv/
backend/venv/
backend/__pycache__/
backend/**/*.py[cod]
backend/.pytest_cache/
backend/.mypy_cache/
backend/.coverage

# Runtime generated during scans
backend/runtime/

# Logs
backend/logs/

# ---------------------
# Node / React
# ---------------------
frontend/node_modules/
frontend/dist/
frontend/.vite/

# ---------------------
# Environment
# ---------------------
.env
*.env
*.local

# ---------------------
# Logs
# ---------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------------------
# IDE
# ---------------------
.vscode/
!.vscode/extensions.json
.idea/

# ---------------------
# Operating System
# ---------------------
.DS_Store
Thumbs.db

# ---------------------
# Visual Studio
# ---------------------
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?